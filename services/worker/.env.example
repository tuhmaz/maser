# services/worker/.env.example
APP_ENV=development
DATABASE_URL=postgres://alemedu:alemedu@localhost:5432/alemedu_dev?sslmode=disable
JOB_INTERVAL_SECONDS=60

# لمهام AI (analyze_book وغيرها لاحقًا) — نفس مفتاح services/api/.env، اتركه
# فارغًا لتعطيل التحليل (يُسجَّل الفشل في book_analyses بدل تجاهل صامت).
TOGETHER_API_KEY=

# يجب أن يطابق STORAGE_DIR في services/api/.env (نفس القرص) — الـworker يقرأ
# الملفات المرفوعة (كتب PDF) مباشرة من هنا.
STORAGE_DIR=../api/storage

# مسار صريح لثنائي pdftotext (poppler) — اتركه فارغًا في Linux مع
# poppler-utils مثبَّتًا (يُكتشف تلقائيًا عبر PATH). اضبطه صراحةً على Windows
# إن كان "pdftotext" على PATH يُشير لنسخة قديمة أخرى (مثلًا المرفقة مع Git for
# Windows) بدل poppler الحقيقي — مثال: C:/Program Files/poppler-25.07.0/Library/bin/pdftotext.exe
PDFTOTEXT_PATH=
