# services/worker/.env.example
APP_ENV=development
DATABASE_URL=postgres://alemedu:alemedu@localhost:5432/alemedu_dev?sslmode=disable
JOB_INTERVAL_SECONDS=60

# يجب أن يطابق STORAGE_DIR في services/api/.env (نفس القرص) — الـworker يقرأ
# الملفات المرفوعة (كتب PDF) مباشرة من هنا.
STORAGE_DIR=../api/storage

# لتحليل كتب المادة (analyze_book) عبر Gemini File API — يقرأ ملف PDF كاملًا
# مباشرة (فهم مستندي أصلي)، لا استخراج نص محلي. اتركه فارغًا لتعطيل التحليل
# (يُسجَّل الفشل بوضوح في book_analyses بدل تجاهل صامت). احصل على مفتاح من
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
