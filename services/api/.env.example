# services/api/.env.example
# انسخ هذا الملف إلى .env محليًا ولا ترفعه أبدًا إلى Git

APP_ENV=development
APP_PORT=8080

DATABASE_URL=postgres://alemedu:alemedu@localhost:5433/alemedu_dev?sslmode=disable
# ملاحظة: المنفذ 5433 (وليس 5432 الافتراضي) لتفادي التعارض مع أي PostgreSQL
# مثبَّت محليًا على الجهاز خارج Docker. عدّله إذا لزم.

REDIS_URL=redis://localhost:6379/0

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# البريد: بدون SMTP_HOST يعمل الخادم في وضع "طباعة في السجلات" بدل الإرسال الفعلي
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@alemedu.com

WEB_BASE_URL=http://localhost:3000

# تخزين الملفات المرفوعة (صور الأسئلة) — محلي في التطوير، يُستبدل بخدمة سحابية في الإنتاج
STORAGE_DIR=./storage
PUBLIC_ASSET_URL=http://localhost:8080/assets

# تسجيل الدخول عبر جوجل/فيسبوك — اتركهما فارغين لتعطيل الزر تلقائيًا في الواجهة
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/oauth/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL=http://localhost:8080/auth/oauth/facebook/callback

# توليد مسودات أسئلة عبر Together AI (docs.together.ai) — اتركه فارغًا لتعطيل
# الميزة تمامًا (يرجع الخادم 503 ai_not_configured بدل خطأ غامض).
TOGETHER_API_KEY=
TOGETHER_DEFAULT_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# قائمة بيضاء بالنماذج المسموح للوحة الإدارة اختيارها (مفصولة بفواصل، بلا مسافات)
TOGETHER_ALLOWED_MODELS=meta-llama/Llama-3.3-70B-Instruct-Turbo,Qwen/Qwen2.5-72B-Instruct-Turbo,deepseek-ai/DeepSeek-V3
